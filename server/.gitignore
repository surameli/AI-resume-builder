# Dependencies
node_modules/
**/node_modules/

# Environment files — NEVER commit these
.env
**/.env
!**/.env.example

# Build outputs
client/dist/
server/dist/

# Prisma generated files (regenerated via prisma generate)
server/node_modules/.prisma/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/settings.json
.idea/
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# Uploads (user files)
server/uploads/

# Temp files
*.tmp
*.temp
