# =============================================================
# CareerCraft AI - Server Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/careercraft_ai?schema=public"

# JWT Secrets (use long, random strings - minimum 64 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_minimum_64_characters_long_random_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_64_characters_long_random_string

# JWT Expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your_cookie_secret_here

# CORS - Frontend origin
CLIENT_URL=http://localhost:5173

# Groq AI (added in Phase 4)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Email (for password reset / verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@careercraft.ai

# App
APP_NAME=CareerCraft AI
APP_URL=http://localhost:5000

# AI Usage Limits (free tier)
FREE_AI_RESUME_LIMIT=5
FREE_AI_COVER_LETTER_LIMIT=3
FREE_AI_ATS_LIMIT=10
FREE_AI_ASSISTANT_LIMIT=50
